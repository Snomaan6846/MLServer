# RHOAIENG-102092 overlay: official odh-master CPU image + pyzmq (zmq transport).
# Only addition vs the official image: the optional pyzmq dependency pinned to
# the version in MLServer master's poetry.lock (27.2.0). No code changes.
FROM quay.io/opendatahub/mlserver@sha256:71b302fcc7dac94795d748601efbb9646cded770ec1feddff4cadcb111c9d11f
USER 0
RUN pip3 install --no-cache-dir pyzmq==27.2.0
USER 1000
