FROM python:3.12-slim

# tar is required for `oc cp` into the running client pod.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tar \
    && rm -rf /var/lib/apt/lists/*

# Versions pinned to the MLServer-resources client venv
# (aiohttp 3.14.5, grpcio 1.84.1, numpy 2.2.6).
RUN pip install --no-cache-dir \
    aiohttp==3.14.5 \
    grpcio==1.84.1 \
    numpy==2.2.6 \
    "kubernetes>=30,<34"

WORKDIR /tools
COPY tools/ /tools/
ENV PYTHONPATH=/tools
USER 1000
CMD ["sleep", "infinity"]
