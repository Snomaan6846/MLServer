      }
    },
    {
      "name": "gpu-prof-w1json",
      "prepare_argv": [
        "python3",
        "/tools/hook.py",
        "gpu-prof-w1json"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr.mlserver-perf.svc:8080/v2/models/rfdetr-small/infer",
        "payloads": [
          "/store/payloads/j0-0.bin"
        ],
        "min_response_bytes": 500000
      }
