{
  "round_offset": 0,
  "rounds": 3,
  "clients": 2,
  "seconds": 60,
  "warmup_seconds": 60,
  "warmup_requests": 256,
  "timeout_seconds": 120,
  "ready_timeout_seconds": 300,
  "prepare_timeout_seconds": 900,
  "max_start_lateness_ms": 20,
  "concurrency": [
    64
  ],
  "session": "mlp-B5-transport",
  "variants": [
    {
      "name": "mlp-json-frontend-queue@r1",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "mlp-json-frontend-queue"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr-cpu.mlserver-perf.svc:8080/v2/models/mlp-small/infer",
        "payloads": [
          "/store/payloads/j0-mlp-small-1.bin"
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "min_response_bytes": 20
      }
    },
    {
      "name": "mlp-json-worker-queue@r1",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "mlp-json-worker-queue"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr-cpu.mlserver-perf.svc:8080/v2/models/mlp-small/infer",
        "payloads": [
          "/store/payloads/j0-mlp-small-1.bin"
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "min_response_bytes": 20
      }
    },
    {
      "name": "mlp-bin-worker-queue@r1",
      "prepare_argv": [
        "python3",
        "/store/tools/hook.py",
        "mlp-bin-worker-queue"
      ],
      "spec": {
        "protocol": "rest",
        "url": "http://mlserver-rfdetr-cpu.mlserver-perf.svc:8080/v2/models/mlp-small/infer",
        "payloads": [
          "/store/payloads/triton-binary-mlp-small-1.bin"
        ],
        "headers": {
          "Content-Type": "application/octet-stream",
          "Inference-Header-Content-Length": "164"
        },
        "min_response_bytes": 20
      }
    }
  ]
}
